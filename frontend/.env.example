# Frontend environment configuration (Vite).
# Copy to .env.local and adjust values. VITE_ variables are embedded
# in the client bundle — never place backend secrets here.

# Base URL of the CURVIN backend API. Leave empty in local development
# to use the Vite dev-server proxy (localhost:8000). In deployed
# environments (Vercel) set it to the backend origin, e.g.
# https://curvin-pvt.onrender.com
VITE_API_BASE_URL=
